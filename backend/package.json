{
  "name": "takarlaba-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "tsx watch src/standalone.ts",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed/index.ts",
    "prebuild": "npm run db:generate",
    "build": "tsc",
    "start": "node dist/standalone.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.12",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^5.0.5"
  }
}
