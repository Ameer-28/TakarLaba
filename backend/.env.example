# Server Configuration
PORT=4000
NODE_ENV=development

# Neon PostgreSQL Database
# Runtime uses pooled connection; Migrations/CLI use direct unpooled connection
DATABASE_URL="postgresql://user:password@ep-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Features & Seeds
DEMO_MODE=true
